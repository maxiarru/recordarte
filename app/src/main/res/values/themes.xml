<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MisActividades" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#6750A4</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.MisActividades.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FF9F43</item>
        <item name="android:navigationBarColor">#141318</item>
        <item name="android:statusBarColor">#141318</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#141318</item>
    </style>

    <style name="WidgetTaskText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#211F26</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
